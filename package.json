{
    "name": "pinger",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist",
        "startDev": "nodemon",
        "migration:generate": "typeorm migration:generate -d dist/src/dataSource.js src/migrations/$npm_config_name",
        "migration:run": "typeorm migration:run -d dist/src/dataSource.js",
        "typeorm": "typeorm-ts-node-esm",
        "test": "node --require ts-node/register --test --test-concurrency=4 'src/**/*.test.ts'",
        "format": "prettier --write '**/*.ts'",
        "lint": "prettier --check '**/*.ts' && npm run type:check",
        "type:check": "tsc --noEmit"
    },
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "nodemon": "^3.1.4",
        "prettier": "^3.10.1",
        "prettier-plugin-organize-imports": "^4.3.0",
        "ts-node": "^10.9.1",
        "typescript": "^4.6.4"
    },
    "dependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.13",
        "@types/node": "^20.3.1",
        "body-parser": "^1.20.2",
        "cors": "^2.8.5",
        "cron": "^4.4.0",
        "dotenv": "^16.0.3",
        "express": "^4.21.2",
        "http-status": "^1.6.2",
        "joi": "^17.13.3",
        "jsonwebtoken": "^9.0.2",
        "matrix-bot-sdk": "^0.8.0",
        "pg": "^8.22.0",
        "pg-connection-string": "^2.14.0",
        "typeorm": "^0.3.16"
    },
    "engines": {
        "node": "^26.13.1"
    },
    "prettier": {
        "plugins": [
            "prettier-plugin-organize-imports"
        ]
    }
}
